SET PATH=@NASM_EXE_DIRECTORY_NATIVE@;%PATH%
SET MSYS2_PATH_TYPE=inherit
SET CHERE_INVOKING=1
@BASH_EXE_PATH@ --login -c "./configure --prefix=@FFMPEG_INSTALL_DIR@ --toolchain=msvc --arch=@FFMPEG_ARCH@ --target-os=@FFMPEG_TARGET_OS@ --disable-doc --disable-programs --disable-autodetect --disable-debug --enable-gpl --enable-nonfree --enable-librubberband --enable-libmysofa --pkg-config=@PKG_CONFIG_TEMP_DIR@/pkg-config --extra-cflags=-I@THIRDPARTY_INC_DIR@ --extra-ldflags='-LIBPATH:@THIRDPARTY_LIB_DIR@ rubberband.lib mysofa.lib fftw3f.lib' && make @TOOLCHAIN_BUILD_MAKEJOBS@ && make install"
