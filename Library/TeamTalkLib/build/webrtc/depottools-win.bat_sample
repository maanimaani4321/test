SET DEPOT_TOOLS_WIN_TOOLCHAIN=0
SET PATH=@DEPOTTOOLS_DIR_NATIVE@;%PATH%
CD @WEBRTC_FETCH_PATH_NATIVE@
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CALL fetch --nohooks --no-history webrtc
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CD @WEBRTC_SOURCE_ROOT_NATIVE@
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CALL git config --add remote.origin.fetch "+refs/branch-heads/*:refs/remotes/origin/*"
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CALL git fetch --depth=1 origin branch-heads/7778
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CALL git checkout branch-heads/7778
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CD @WEBRTC_FETCH_PATH_NATIVE@
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

CALL gclient sync --with_branch_heads --no-history --shallow -D -j16
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

ECHO Finished fetching WebRTC
EXIT /B 0

:fail
EXIT /B 1