@ECHO OFF
IF NOT EXIST "@WEBRTC_FETCH_PATH_NATIVE@" MKDIR "@WEBRTC_FETCH_PATH_NATIVE@"
CD /D "@WEBRTC_FETCH_PATH_NATIVE@"
IF NOT "%ERRORLEVEL%" == "0" GOTO fail

IF NOT EXIST "@DEPOTTOOLS_DIR_NATIVE@" (
    CALL git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git "@DEPOTTOOLS_DIR_NATIVE@"
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail
)

SET DEPOT_TOOLS_WIN_TOOLCHAIN=0
SET PATH=@DEPOTTOOLS_DIR_NATIVE@;%PATH%

IF NOT EXIST "@WEBRTC_SOURCE_ROOT_NATIVE@" (
    CD /D "@WEBRTC_FETCH_PATH_NATIVE@"
    CALL fetch --nohooks webrtc
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail

    CD /D "@WEBRTC_SOURCE_ROOT_NATIVE@"
    CALL git config --add remote.origin.fetch "+refs/branch-heads/*:refs/remotes/origin/*"
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail

    CALL git fetch origin
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail

    CALL git checkout branch-heads/7778
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail

    CD /D "@WEBRTC_FETCH_PATH_NATIVE@"
    CALL gclient sync --with_branch_heads -D @TOOLCHAIN_BUILD_MAKEJOBS@
    IF NOT "%ERRORLEVEL%" == "0" GOTO fail
)

ECHO Finished fetching and syncing WebRTC
EXIT /B 0

:fail
ECHO Failed during depottools-win.bat
EXIT /B 1